{
  "name": "manageiq-ui-service-react",
  "version": "0.1.0",
  "description": "ManageIQ Service UI - React Application",
  "packageManager": "yarn@4.14.1",
  "scripts": {
    "start": "webpack serve --config config/webpack.dev.js",
    "build": "NODE_ENV=production webpack --config config/webpack.prod.js",
    "build:dev": "webpack --config config/webpack.dev.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "tsc --noEmit",
    "i18n:extract": "ttag extract --marker-names __,N_ $(find src -name '*.ts' -o -name '*.tsx') -o ../client/gettext/po/manageiq-ui-service.pot",
    "i18n:update": "ttag update ../client/gettext/po/*/manageiq-ui-service.po ../client/gettext/po/manageiq-ui-service.pot",
    "i18n:compile": "ttag po2json ../client/gettext/po/*/manageiq-ui-service.po -o public/locales"
  },
  "dependencies": {
    "@carbon/charts": "^1.27.11",
    "@carbon/charts-react": "^1.27.11",
    "@carbon/icons-react": "^11.82.0",
    "@carbon/react": "^1.109.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.17.0",
    "classnames": "^2.5.1",
    "core-js": "^3.49.0",
    "date-fns": "^4.4.0",
    "lodash": "^4.18.1",
    "numeral": "^2.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.7",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.17.0",
    "sass": "^1.100.0",
    "ttag": "^1.8.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7",
    "@types/babel__preset-env": "^7",
    "@types/gettext-parser": "^9",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4",
    "@types/node": "^25.9.1",
    "@types/numeral": "^2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@types/react-is": "^19",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "babel-jest": "^30.4.1",
    "babel-loader": "^10.1.1",
    "babel-plugin-ttag": "^1.8.16",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "gettext-parser": "^9.0.2",
    "html-webpack-plugin": "^5.6.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-watch-typeahead": "^3.0.1",
    "mini-css-extract-plugin": "^2.10.2",
    "msw": "^2.14.6",
    "prettier": "^3.5.1",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ttag-cli": "^1.12.0",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.4",
    "webpack-merge": "^6.0.1"
  }
}
